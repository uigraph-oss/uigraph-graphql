extend type Query {
    serverOverview:      ServerOverview!
    serverConfig:        ServerConfig!

    serverOrgs:          [Org!]!

    users:               [User!]!
    user(id: ID!):       User!

    ldap:                LDAPConfig
    scim:                SCIMConfig
}

extend type Mutation {
    createServerOrg(input: CreateServerOrgInput!):           Org!
    updateServerOrg(id: ID!, input: UpdateServerOrgInput!):  Org!
    deleteServerOrg(id: ID!):                                Boolean!

    prepareServerOrgLogoUpload(orgId: ID!): AssetUpload!
    setServerOrgLogo(orgId: ID!):           Boolean!
    removeServerOrgLogo(orgId: ID!):        Boolean!

    createUser(input: CreateUserInput!):              User!
    updateUser(id: ID!, input: UpdateUserInput!):     User!
    disableUser(id: ID!):                             Boolean!

    upsertLDAP(input: UpsertLDAPInput!): Boolean!
    deleteLDAP:                          Boolean!
}

# ── Types ─────────────────────────────────────────────────────────────────────

type ServerOverview {
    totalUsers:  Int!
    activeUsers: Int!
    totalOrgs:   Int!
}

type ServerConfig {
    storageBackend:   String!
    storageBucket:    String!
    storageEndpoint:  String!
    vectorBackend:    String!
    embeddingBackend: String!
    embeddingModel:   String!
}

type User {
    id:         ID!
    email:      String!
    name:       String!
    login:      String!
    disabled:   Boolean!
    role:       String!
    avatarUrl:  String
    lastSeenAt: Time
    createdAt:  Time!
    updatedAt:  Time!
}

type LDAPConfig {
    id:                ID!
    host:              String!
    port:              Int!
    useSsl:            Boolean!
    startTls:          Boolean!
    skipTlsVerify:     Boolean!
    bindDn:            String!
    bindPassword:      String!
    searchBaseDn:      String!
    searchFilter:      String!
    emailAttribute:    String!
    nameAttribute:     String!
    usernameAttribute: String!
    memberOfAttribute: String!
    allowSignUp:       Boolean!
    createdAt:         Time!
    updatedAt:         Time!
}

type SCIMConfig {
    id: ID!
}

# ── Inputs ────────────────────────────────────────────────────────────────────

input CreateServerOrgInput {
    name:     String!
    autoJoin: Boolean
}

input UpdateServerOrgInput {
    name:     String
    disabled: Boolean
    autoJoin: Boolean
}

input CreateUserInput {
    email:    String!
    name:     String!
    password: String!
    role:     String
}

input UpdateUserInput {
    name:     String
    role:     String
    disabled: Boolean
}

input UpsertLDAPInput {
    host:              String!
    port:              Int!
    useSsl:            Boolean!
    startTls:          Boolean!
    skipTlsVerify:     Boolean!
    bindDn:            String
    bindPassword:      String
    searchBaseDn:      String!
    searchFilter:      String!
    emailAttribute:    String!
    nameAttribute:     String!
    usernameAttribute: String!
    memberOfAttribute: String!
    allowSignUp:       Boolean!
}
